SECRET_KEY=change-me-in-production
# DEBUG already defaults to False if unset — this file sets it to True only because
# it's the local-dev template. Do NOT copy this line's value into a production host's
# env vars; leave DEBUG unset there (or set it to False explicitly) instead.
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Only needed in production (see backend/README-DEPLOY.md). Comma-separated origins
# that are allowed to send unsafe (POST/PUT/etc) requests with a session cookie —
# mainly the Django admin login. Must include the scheme, e.g. https://api.example.com
CSRF_TRUSTED_ORIGINS=

# Postgres connection string (e.g. from Neon) — postgres://user:password@host/dbname
# Leave unset for local dev; falls back to a local SQLite file automatically.
# DATABASE_URL=postgres://user:password@host/dbname

# Email — used for the admin "forgot password" flow. Falls back to printing emails to
# the console when left blank, so local dev works without real credentials.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=

# Base URL of the frontend — used to build the link inside password-reset emails.
FRONTEND_URL=http://localhost:5173
